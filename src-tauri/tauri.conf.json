{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bloco de Notas",
  "version": "0.1.0",
  "identifier": "com.marcopolomoreno.bloconotas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bloco de Notas",
        "width": 900,
        "height": 640,
        "minWidth": 420,
        "minHeight": 260,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 26 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Bloco de notas com abas",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["txt", "text", "log", "md", "csv", "ini", "cfg", "json", "xml", "yml", "yaml"],
        "name": "Documento de texto",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
